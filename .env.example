# Copy to .env.local and fill in. Never commit real secrets.
# See docs/runbook.md for where each value comes from.

# Required
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
NEXTAUTH_URL=https://<your-production-domain>
NEXTAUTH_SECRET=<openssl rand -base64 32>
ADMIN_EMAILS=owner@example.com

# Cron (Vercel scheduler calls /api/cron/*?secret=... — see vercel.json)
CRON_SECRET=<openssl rand -hex 32>

# OAuth (only when the provider button is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# GitHub release sync (only when the webhook is enabled)
# Callback: https://<your-production-domain>/api/webhooks/github (content-type json, event: releases)
GITHUB_WEBHOOK_SECRET=<openssl rand -hex 32>
# Optional allowlist, comma "owner/repo". Empty = any repo with a valid signature.
GITHUB_WEBHOOK_ALLOWED_REPOS=kaziweblab-oss/kwl-video-downloader
# Optional fallback PAT when no integration token is stored (server-side only)
GITHUB_TOKEN=

# No NEXT_PUBLIC_* secrets may exist. Public config (none required today) stays non-secret.
